# Dockerfile.api — Lattice DOE REST API server
# Build: docker build -f Dockerfile.api -t lattice-api .
# Run:   docker run -p 8000:8000 lattice-api

FROM python:3.11-slim

# Install curl for HEALTHCHECK
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only what pip needs first (layer-cache friendly). The REST server
# lives inside the package (lattice_doe/api_server), so one copy suffices.
COPY pyproject.toml README.md ./
COPY lattice_doe/ ./lattice_doe/

# Install the package with server extras
RUN pip install --no-cache-dir -e ".[server]"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=25s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default to ONE worker: the async /jobs API keeps its state in process
# memory, so with N > 1 workers a GET /jobs/{id} routed to a different
# worker than the POST returns 404. Raise UVICORN_WORKERS only if you do
# not use /jobs (or you add sticky routing / a shared store).
# Shell form so the UVICORN_WORKERS override actually takes effect (the
# previous exec-form CMD hardcoded the count and ignored the env var).
CMD uvicorn lattice_doe.api_server.main:create_app --factory \
    --host 0.0.0.0 --port 8000 \
    --workers "${UVICORN_WORKERS:-1}" \
    --log-level info
